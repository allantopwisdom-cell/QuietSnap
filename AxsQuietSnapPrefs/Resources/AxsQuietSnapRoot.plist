<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>静默快拍</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>基本设置</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>key</key><string>enabled</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><false/>
            <key>footerText</key><string>总开关，修改后无需注销。</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>手势</string>
            <key>footerText</key><string>为同一手势绑定多个功能时，优先级为：照片 &gt; 录像 &gt; 录音。选择「不使用手势」时，录音/录像仍可从控制中心触发。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>label</key><string>拍照</string>
            <key>key</key><string>photoGesture</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><integer>3</integer>
            <key>detail</key><string>PSListItemsController</string>
            <key>validValues</key>
            <array>
                <integer>0</integer><integer>1</integer><integer>2</integer>
                <integer>3</integer><integer>4</integer><integer>5</integer><integer>6</integer><integer>7</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>无</string>
                <string>单击音量加</string>
                <string>单击音量减</string>
                <string>双击音量加</string>
                <string>双击音量减</string>
                <string>长按音量加</string>
                <string>长按音量减</string>
                <string>不使用手势</string>
            </array>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>label</key><string>录像</string>
            <key>key</key><string>videoGesture</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><integer>5</integer>
            <key>detail</key><string>PSListItemsController</string>
            <key>validValues</key>
            <array>
                <integer>0</integer><integer>1</integer><integer>2</integer>
                <integer>3</integer><integer>4</integer><integer>5</integer><integer>6</integer><integer>7</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>无</string>
                <string>单击音量加</string>
                <string>单击音量减</string>
                <string>双击音量加</string>
                <string>双击音量减</string>
                <string>长按音量加</string>
                <string>长按音量减</string>
                <string>不使用手势</string>
            </array>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>label</key><string>录音</string>
            <key>key</key><string>audioGesture</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><integer>6</integer>
            <key>detail</key><string>PSListItemsController</string>
            <key>validValues</key>
            <array>
                <integer>0</integer><integer>1</integer><integer>2</integer>
                <integer>3</integer><integer>4</integer><integer>5</integer><integer>6</integer><integer>7</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>无</string>
                <string>单击音量加</string>
                <string>单击音量减</string>
                <string>双击音量加</string>
                <string>双击音量减</string>
                <string>长按音量加</string>
                <string>长按音量减</string>
                <string>不使用手势</string>
            </array>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>拍摄</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>label</key><string>摄像头</string>
            <key>key</key><string>position</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><string>back</string>
            <key>detail</key><string>PSListItemsController</string>
            <key>validValues</key><array><string>back</string><string>front</string></array>
            <key>validTitles</key><array><string>后置</string><string>前置</string></array>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>0.5x 超广角</string>
            <key>key</key><string>ultra</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><false/>
            <key>footerText</key><string>仅后置摄像头可用，设备不支持时自动回退到 1x。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>锁屏时禁用</string>
            <key>key</key><string>disableWhenLocked</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><false/>
            <key>footerText</key><string>开启后锁屏状态下忽略音量键手势（控制中心仍可用）。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>静音拍摄</string>
            <key>key</key><string>silentCapture</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><true/>
            <key>footerText</key><string>拍摄瞬间屏蔽系统快门与提示音（不影响震动）。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>label</key><string>画质</string>
            <key>key</key><string>quality</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><string>1080p</string>
            <key>detail</key><string>PSListItemsController</string>
            <key>validValues</key>
            <array><string>480p</string><string>720p</string><string>1080p</string><string>4k</string></array>
            <key>validTitles</key>
            <array><string>480p</string><string>720p</string><string>1080p</string><string>4K</string></array>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>label</key><string>帧率</string>
            <key>key</key><string>fps</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><integer>30</integer>
            <key>detail</key><string>PSListItemsController</string>
            <key>validValues</key><array><integer>24</integer><integer>30</integer><integer>60</integer></array>
            <key>validTitles</key><array><string>24 fps</string><string>30 fps</string><string>60 fps</string></array>
        </dict>

        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>label</key><string>最长录像时长</string>
            <key>key</key><string>maxVideoMinutes</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><integer>0</integer>
            <key>detail</key><string>PSListItemsController</string>
            <key>validValues</key><array><integer>0</integer><integer>1</integer><integer>3</integer><integer>5</integer><integer>10</integer></array>
            <key>validTitles</key><array><string>不限</string><string>1 分钟</string><string>3 分钟</string><string>5 分钟</string><string>10 分钟</string></array>
            <key>footerText</key><string>到达时长后自动停止录像，0 表示不限制。</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>输出</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>保存到相册</string>
            <key>key</key><string>saveToPhotos</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><true/>
            <key>footerText</key><string>关闭后照片和视频保存到下方目录；相册写入失败时会自动落盘。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>显示提示浮层</string>
            <key>key</key><string>showToast</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><false/>
            <key>footerText</key><string>拍摄开始/保存后显示一条不可触摸的轻提示。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>触感反馈</string>
            <key>key</key><string>haptic</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>录音时保持其他音频</string>
            <key>key</key><string>mix</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><true/>
            <key>footerText</key><string>开启后录音不会打断正在播放的音乐。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>保存目录</string>
            <key>key</key><string>savePath</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><string>/var/mobile/Media/QuietSnap</string>
            <key>placeholder</key><string>/var/mobile/Media/QuietSnap</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>文件名格式</string>
            <key>key</key><string>fileName</string>
            <key>defaults</key><string>com.axs.quietsnap</string>
            <key>default</key><string>yyyyMMdd_HHmmss</string>
            <key>placeholder</key><string>yyyyMMdd_HHmmss</string>
            <key>footerText</key><string>日期格式，例如 yyyyMMdd_HHmmss。</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>说明</string>
            <key>footerText</key><string>本插件不隐藏系统相机/麦克风指示点。首次使用若拍摄失败，请确认 SpringBoard 已获得相机与麦克风权限。</string>
        </dict>
    </array>
</dict>
</plist>
